#!/usr/bin/env bash

pnpm_version="12.15.0"

set -e -u -x
source ./tasks/helpers.sh

env
PATH="$DEV_PATH" PREFIX="$DEV_INSTALL_PREFIX" npm install -g --force "pnpm@${pnpm_version}"

mkdir -p ~/.config/pnpm
printf "updateNotifier: false\nstoreDir: %s/store\n" "$PNPM_HOME" > ~/.config/pnpm/config.yaml

stamp
