#!/usr/bin/env bash

set -e -u -x
source ./tasks/helpers.sh

hugo_version="0.170.1"
hugo_hash="841a5462853aefc9942e4de1e8a5d75584b6a5181941e6ad3f1d745190e03cd8"
if [ "$TARGETARCH" == "arm64" ]; then
  hugo_hash="6f57f13bc47c000c0d36c7f5a446d6c06f7956d8e102cc2a13735e0c0225b2d2"
fi

task_working_dir
download "https://github.com/gohugoio/hugo/releases/download/v${hugo_version}/hugo_${hugo_version}_linux-${TARGETARCH}.tar.gz" "sha256" "$hugo_hash"
extract_download "hugo_${hugo_version}_linux-${TARGETARCH}.tar.gz"

install -D -m 755 "hugo" "$DEV_INSTALL_PREFIX/bin/hugo"

stamp
