#!/usr/bin/env bash

trafficserver_version="10.2.0-rc1"
trafficserver_base_version="10.2.0"
trafficserver_hash="dc32cb6da0fc0b4eb4dc0ac7c1bb465eebc3fa27ff5c8611b686958b295a548492b336f0b4356d1848999ada2988d926c4538f678c68b0ba38cf3252bef72119"

set -e -u -x
source ./tasks/helpers.sh
source ./tasks/helpers/detect_os_release.sh

task_working_dir
download "https://dist.apache.org/repos/dist/dev/trafficserver/$trafficserver_base_version/trafficserver-$trafficserver_version.tar.bz2" "sha512" "$trafficserver_hash"
extract_download "trafficserver-$trafficserver_version.tar.bz2"

cd "trafficserver-$trafficserver_base_version"

# Propagate client aborts throughout the other proxy layers and to the upstream
# server:
# https://github.com/apache/trafficserver/issues/13549
patch -p1 < "$SOURCE_DIR/build/patches/trafficserver-client-aborts.patch"

cmake -B build \
  -DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX_EMBEDDED" \
  -DENABLE_LUAJIT=ON \
  -Dluajit_INCLUDE_DIRS="$STAGE_EMBEDDED_DIR/openresty/luajit/include/luajit-2.1" \
  -Dluajit_LIBRARY_DIRS="$STAGE_EMBEDDED_DIR/openresty/luajit/lib" \
  -Dluajit_LIBRARIES=luajit-5.1 \
  -Dluajit_LINK_LIBRARIES=luajit-5.1 \
  -DENABLE_JEMALLOC=ON

cmake --build build -j "$NPROC"

cmake --install build --prefix="$STAGE_EMBEDDED_DIR"

chrpath -d "$STAGE_EMBEDDED_DIR/lib/libswoc.so"
chrpath -d "$STAGE_EMBEDDED_DIR/lib/libtsapi.so"
chrpath -d "$STAGE_EMBEDDED_DIR/lib/libtscppapi.so"
chrpath -d "$STAGE_EMBEDDED_DIR/lib/libyaml-cpp.so"
find "$STAGE_EMBEDDED_DIR/libexec/trafficserver/" -name "*.so" -exec chrpath -d {} \;
find "$STAGE_EMBEDDED_DIR/bin/" -name "traffic_*" -exec chrpath -d {} \;

stamp
